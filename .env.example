# Arduino serial connection
SERIAL_PORT=/dev/ttyACM0
SERIAL_BAUD_RATE=115200
SERIAL_TIMEOUT_SECONDS=2

# Exporter and local monitoring ports
METRICS_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOG_LEVEL=INFO

# Optional MQTT publication; the local Compose stack includes Mosquitto
MQTT_ENABLED=true
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_HOST_PORT=1883
MQTT_TOPIC=home/sensors/environment
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_CLIENT_ID=home-sensors-exporter

# Local Grafana administrator credentials; change before network exposure
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
